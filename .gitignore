# See https://help.github.com/articles/ignoring-files/ for more profile ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files (can opt-in for commiting if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# vendored skills (local-machine symlink, not portable)

# Agent tooling - machine-local state, not shared config
.claude/settings.json
.claude/settings.local.json
.claude/worktrees/
.agents/settings.json
.agents/settings.local.json
.agents/worktrees/

